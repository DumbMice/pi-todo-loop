{
	"name": "pi-todo-loop",
	"version": "0.1.0",
	"description": "Pi extension: keep the agent working while an rpiv-todo list still has open tasks, and keep that list in context across compaction.",
	"type": "module",
	"license": "MIT",
	"author": {
		"name": "DumbMice",
		"email": "bangchengyang@hotmail.com"
	},
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"pi-coding-agent",
		"todo",
		"continuation",
		"rpiv-todo",
		"agent-loop"
	],
	"homepage": "https://github.com/DumbMice/pi-todo-loop#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DumbMice/pi-todo-loop.git"
	},
	"bugs": "https://github.com/DumbMice/pi-todo-loop/issues",
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"files": [
		"src",
		"docs",
		"README.md",
		"AGENTS.md",
		"CONTRIBUTING.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
		"typecheck": "tsc -p tsconfig.json",
		"pack:check": "npm pack --dry-run"
	},
	"engines": {
		"node": ">=22.6"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"typescript": "^5.9.3"
	}
}
